{
  "private": true,
  "name": "binarygrid",
  "version": "0.1.1",
  "type": "module",
  "packageManager": "bun@1.4.3",
  "scripts": {
    "postinstall": "bun run build",
    "build": "vite build",
    "deploy": "bun run build && devvit upload",
    "dev": "devvit playtest",
    "preview": "vite preview",
    "login": "devvit login",
    "check": "svelte-check --tsconfig ./src/client/tsconfig.json",
    "launch": "bun run build && bun run deploy && devvit publish",
    "type-check": "node node_modules/@typescript/native/bin/tsc --build",
    "test": "vitest run",
    "local": "vite dev --port 7474"
  },
  "dependencies": {
    "@devvit/start": "0.15.0",
    "@devvit/test": "0.15.0",
    "@devvit/web": "0.15.0",
    "@hono/node-server": "^2.1.5",
    "@lucide/svelte": "^1.61.0",
    "@tailwindcss/vite": "^4.3.3",
    "canvas-confetti": "^1.9.4",
    "devvit": "0.15.0",
    "hono": "^4.13.13",
    "tailwindcss": "^4.3.3"
  },
  "overrides": {
    "lodash": "4.18.1",
    "minimatch@3": "3.1.5",
    "minimatch@5": "5.1.9",
    "tmp": "0.2.7"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.6.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "concurrently": "^10.0.6",
    "dotenv-cli": "^11.0.0",
    "fast-check": "^4.10.2",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "~6.0.3",
    "vite": "8.3.5",
    "vitest": "^5.0.5"
  }
}
