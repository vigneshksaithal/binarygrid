{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "binarygrid",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "entry": "index.html",
        "inline": true,
        "height": "tall"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "permissions": {
    "redis": true,
    "reddit": {
      "asUser": [
        "SUBSCRIBE_TO_SUBREDDIT",
        "SUBMIT_COMMENT"
      ]
    }
  },
  "media": {
    "dir": "assets"
  },
  "menu": {
    "items": [
      {
        "label": "Create a new Game",
        "description": "Binary Grid",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-create"
      },
      {
        "label": "Show Baseline Metrics",
        "description": "Latest WRS, new users and day-1 retention",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/baseline-readout"
      },
      {
        "label": "Show Post Slot and Shop Numbers",
        "description": "Median solvers per post by slot (8 weeks), daily shop and app openers",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/slot-shop-readout"
      }
    ]
  },
  "triggers": {
    "onAppInstall": "/internal/on-app-install"
  },
  "scheduler": {
    "tasks": {
      "daily-post-morning": {
        "endpoint": "/internal/schedule/daily",
        "cron": "0 8 * * *"
      },
      "daily-post-evening": {
        "endpoint": "/internal/schedule/daily",
        "cron": "0 20 * * *"
      },
      "baseline-nightly": {
        "endpoint": "/internal/schedule/baseline",
        "cron": "30 0 * * *"
      }
    }
  },
  "dev": {
    "subreddit": "cat543"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  }
}
